# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.ipynb_checkpoints/

# Data and logs: large, kept out of git (folders kept via .gitkeep)
data/**
!data/**/
!data/**/.gitkeep
logs/*
!logs/.gitkeep

